{
  "name": "nestjs-microservice-template",
  "version": "1.0.0",
  "description": "Template base para microservicios con NestJS y GraphQL",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postbuild": "copyfiles -V \"src/**/*.graphql\" dist",
    "build": "nest build",
    "prebuild": "rm -rf dist && npx ts-node generate-typings",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"src/**/*.graphql\" ",
    "start": "nest start",
    "start:dev": "ts-node generate-typings && nest start --watch",
    "start:debug": "ts-node generate-typings && nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "postinstall": "link-module-alias",
    "schema:check": "sh ./schema-check.sh"
  },
  "dependencies": {
    "@apollo/server": "^5.3.0",
    "@apollo/server-plugin-response-cache": "^5.0.0",
    "@apollo/utils.keyvadapter": "^4.0.1",
    "@as-integrations/express5": "^1.1.2",
    "@fintechinnovaciondev/fi-utils": "^1.4.1",
    "@keyv/redis": "^5.1.6",
    "@nestjs/apollo": "^13.2.3",
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.12",
    "@nestjs/graphql": "^13.2.3",
    "@nestjs/platform-express": "^11.1.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "graphql": "^16.12.0",
    "graphql-upload-ts": "^2.1.3",
    "keyv": "^5.6.0",
    "link-module-alias": "^1.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-morph": "^27.0.2"
  },
  "devDependencies": {
    "@graphql-tools/merge": "^9.1.7",
    "@nestjs/cli": "^11.0.16",
    "@types/node": "^25.1.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.2",
    "glob": "^13.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "_moduleAliases": {
    "fi-utils": "node_modules/@fintechinnovaciondev/fi-utils/index.js"
  }
}
